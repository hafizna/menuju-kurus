# PIN to log into the app (any string, e.g. a 6-digit number)
APP_PASSWORD=

# Google AI Studio API key (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override, defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Upstash Redis (free tier) — auto-filled if you add the Upstash integration
# from the Vercel dashboard. Otherwise copy from your Upstash database's
# "REST API" tab.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret bearer token you invent yourself, used by the Apple Shortcuts
# automation to push Active Energy data to /api/health-sync
HEALTH_SYNC_TOKEN=
