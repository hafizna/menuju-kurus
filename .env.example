# Secret used to sign session cookies (any long random string). Not tied to
# any user's PIN, so rotating a PIN doesn't need to touch this.
SESSION_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials
# → Create OAuth client ID → Web application). Add this app's URL + the path
# below as an Authorized redirect URI: https://yourapp.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# User 1 (required). EMAIL is the Gmail address that's allowed to register —
# login is "Sign in with Google", gated to exactly these emails, so no one
# else can ever create an account here. After the first Google sign-in each
# user sets their own 6-digit PIN (stored hashed in Redis) for fast everyday
# login, so Google isn't needed again unless they forget their PIN.
USER1_NAME=
USER1_EMAIL=
# Secret bearer token you invent yourself, used by USER1's Apple Shortcuts
# automation to push Active Energy data to /api/health-sync
USER1_HEALTH_SYNC_TOKEN=

# User 2 (optional — leave USER2_EMAIL empty to run single-user)
USER2_NAME=
USER2_EMAIL=
USER2_HEALTH_SYNC_TOKEN=

# User 3-5 (optional) — use a distinct email and Health Sync token per user
USER3_NAME=
USER3_EMAIL=
USER3_HEALTH_SYNC_TOKEN=

USER4_NAME=
USER4_EMAIL=
USER4_HEALTH_SYNC_TOKEN=

USER5_NAME=
USER5_EMAIL=
USER5_HEALTH_SYNC_TOKEN=

# Google AI Studio API key (free tier) — https://aistudio.google.com/apikey
# Required: used for food photo analysis (vision), which DeepSeek can't do.
GEMINI_API_KEY=
# Optional override, defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# DeepSeek API key (prepaid, very cheap per token) — https://platform.deepseek.com
# Used for the text-only AI calls: weekly summary, fitness recap, satiety
# recap. Leave empty and those "Buat recap"/"Buat ringkasan" buttons will
# just show an error — food photo analysis still works via Gemini above.
DEEPSEEK_API_KEY=
# Optional override, defaults to deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat

# Upstash Redis (free tier) — auto-filled if you add the Upstash integration
# from the Vercel dashboard. Otherwise copy from your Upstash database's
# "REST API" tab.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
