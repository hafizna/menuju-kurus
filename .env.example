# Secret used to sign session cookies (any long random string). Not tied to
# any user's PIN, so rotating a PIN doesn't need to touch this.
SESSION_SECRET=

# User 1 (required)
USER1_NAME=
USER1_PASSWORD=
# Secret bearer token you invent yourself, used by USER1's Apple Shortcuts
# automation to push Active Energy data to /api/health-sync
USER1_HEALTH_SYNC_TOKEN=

# User 2 (optional — leave USER2_PASSWORD empty to run single-user)
USER2_NAME=
USER2_PASSWORD=
USER2_HEALTH_SYNC_TOKEN=

# Google AI Studio API key (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override, defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Upstash Redis (free tier) — auto-filled if you add the Upstash integration
# from the Vercel dashboard. Otherwise copy from your Upstash database's
# "REST API" tab.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
